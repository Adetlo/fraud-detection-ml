# Copy to .env for local overrides. Every value has a safe default; nothing here is a secret.
# All settings are read by fraud_ml.config.Settings (prefix FRAUD_ML_).

# Where trained artifacts live. The API loads <FRAUD_ML_MODEL_DIR>/latest at startup.
FRAUD_ML_MODEL_DIR=./models
FRAUD_ML_DATA_DIR=./data
FRAUD_ML_REPORTS_DIR=./reports

# Local file-based MLflow tracking (no server required). Set FRAUD_ML_MLFLOW_ENABLED=false to disable.
FRAUD_ML_MLFLOW_ENABLED=true
FRAUD_ML_MLFLOW_TRACKING_URI=file:./mlruns
FRAUD_ML_MLFLOW_EXPERIMENT=fraud-risk-scoring

# Illustrative cost model used for threshold selection (synthetic units, not currency).
FRAUD_ML_FALSE_NEGATIVE_COST=100
FRAUD_ML_FALSE_POSITIVE_COST=5
FRAUD_ML_TRUE_POSITIVE_COST=1

# Threshold policy: hit the recall target without exceeding the review-rate ceiling.
FRAUD_ML_RECALL_TARGET=0.80
FRAUD_ML_MAX_REVIEW_RATE=0.05
FRAUD_ML_PRIORITY_PRECISION_TARGET=0.75

# API limits
FRAUD_ML_API_MAX_BATCH_SIZE=1000
FRAUD_ML_API_MAX_REQUEST_BYTES=2000000

# Logging
FRAUD_ML_LOG_LEVEL=INFO
FRAUD_ML_LOG_FORMAT=console
