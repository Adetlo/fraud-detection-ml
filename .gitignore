# Generated datasets (small committed fixtures live in data/samples/)
data/*
!data/.gitkeep
!data/samples/
data/samples/*
!data/samples/*.parquet
!data/samples/*.jsonl
!data/samples/README.md

# Trained model binaries and MLflow local store
models/*
!models/.gitkeep
mlruns/
mlartifacts/

# Locally generated reports (the committed demo artifacts live in reports/demo/)
reports/*
!reports/.gitkeep
!reports/demo/
reports/demo/*
!reports/demo/*.json
!reports/demo/*.csv
!reports/demo/*.png
!reports/demo/README.md

# Temporary scoring files
*.tmp
scores*.parquet

# Benchmarks
benchmarks/*.json

# macOS
.DS_Store

# IDEs
.idea/
.vscode/
*.swp
